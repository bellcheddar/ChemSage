[Unit]
Description=ChemSage Web App (xterm.js + PTY)
After=network.target

[Service]
Type=simple
User=chemsage
WorkingDirectory=/opt/chemsage
EnvironmentFile=/opt/chemsage/.env
ExecStart=/opt/chemsage/.venv/bin/gunicorn -k gevent -w 1 --worker-connections 100 -b 127.0.0.1:8001 --timeout 300 wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
